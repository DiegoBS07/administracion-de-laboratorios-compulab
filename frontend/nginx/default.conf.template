# Contenedor frontend (Context/Servicios.md, punto 6): sirve el build de Vite y reenvía /api al
# backend, así el navegador habla con un solo origen y no hace falta CORS.
# ${BACKEND_URL} lo reemplaza la imagen oficial de nginx al arrancar (envsubst).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Archivos con huella en el nombre: se pueden guardar en caché un año.
    location /assets/ {
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Rutas de la aplicación (/reservar, /cierres/2026/10…): las resuelve React.
    location / {
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
