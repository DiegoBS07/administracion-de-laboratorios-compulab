{
  "name": "compulab-backend",
  "version": "0.1.0",
  "description": "Backend de CompuLab: monolito modular con puertos y adaptadores (docs/07-arquitectura.md).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "aptitud": "depcruise src --config .dependency-cruiser.cjs",
    "build": "npm run aptitud && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run aptitud && vitest run",
    "test:watch": "vitest",
    "verificar": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.9.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "kysely": "0.28.19",
    "pg": "8.23.1"
  }
}
