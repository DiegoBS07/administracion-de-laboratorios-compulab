# Copie este archivo como .env y cambie los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Base de datos (contenedor db)
POSTGRES_USER=compulab_user
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=compulab_db
# Puerto en la máquina local para conectarse con herramientas (DBeaver, psql)
POSTGRES_HOST_PORT=5432

# Frontend: la aplicación queda en http://localhost:FRONTEND_PORT
FRONTEND_PORT=8080

# Backend (debe coincidir con EXPOSE en backend/Dockerfile)
APP_PORT=2000
# true: si la base está vacía, el backend la llena con datos de demostración al arrancar
APP_DATOS_DEMO=true
# Opcional, para demostraciones: hora de arranque simulada (el tiempo sigue corriendo desde ahí)
# APP_HORA_SIMULADA=2026-11-24T10:00:00-06:00
# true cuando el sitio se sirva por HTTPS: la cookie de sesión lleva Secure
APP_COOKIE_SEGURA=false
