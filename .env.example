# Copie este archivo como .env y cambie los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Base de datos (contenedor db)
POSTGRES_USER=compulab_user
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=compulab_db
# Puerto en la máquina local para conectarse con herramientas (DBeaver, psql)
POSTGRES_HOST_PORT=5432

# Backend (debe coincidir con EXPOSE en backend/Dockerfile)
APP_PORT=2000
